# ============================================================
# O Tesouro do Dia das Crianças — pós-compra
# Copie para .env.local (dev) e configure na Vercel (produção).
# NUNCA commite valores reais.
# ============================================================

# URL pública desta aplicação, sem barra no final. Usada nos links de e-mail.
APP_URL=https://aventura.seudominio.com.br

# PostgreSQL (Neon, Supabase, Railway, RDS...). Use a connection string com pooling em serverless.
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# ID do produto principal no checkout (copie do painel do checkout). Só esse produto libera a aventura.
CHECKOUT_PRODUCT_ID=

# Opcional: valor exato de product.type do produto principal (ex.: o tipo que o checkout envia
# para o produto principal, diferente de order bump/upsell). Se vazio, product.type não é filtrado.
CHECKOUT_PRODUCT_TYPE=

# Secret configurado no webhook do checkout. Aceito via "Authorization: Bearer <secret>" ou "x-secret: <secret>".
CHECKOUT_WEBHOOK_SECRET=

# ---------- E-mail (SMTP). Deixe EMAIL_HOST vazio para desativar o envio. ----------
EMAIL_HOST=
EMAIL_PORT=587
# true para porta 465 (TLS implícito). Em 587 use false (STARTTLS).
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Ex.: "O Tesouro do Dia das Crianças <aventura@seudominio.com.br>"
EMAIL_FROM=

# Opcional: pasta dos kits (padrão: ./kits)
# KITS_DIR=
